/assets/*
  Cache-Control: public, max-age=31536000, immutable

/blog/posts.json
  Cache-Control: public, max-age=300, must-revalidate

/oauth/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/dashboard/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/portal/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com; frame-src https://www.googletagmanager.com https://www.google.com; form-action 'self'; base-uri 'self'; upgrade-insecure-requests
